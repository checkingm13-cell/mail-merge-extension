{
  "manifest_version": 3,
  "key": "",
  "name": "Gmail Native Mail Merge & Scheduler",
  "version": "1.0.0",
  "description": "Automate and schedule Gmail native Mail Merge campaigns with local database storage.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://docs.google.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/db/idb-store.js",
        "src/content/gmail-automator.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/dashboard/dashboard.html",
        "src/dashboard/*",
        "icons/*"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}
